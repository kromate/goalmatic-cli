  "sourceVersionId": "__LATEST_SAVED_VERSION__",
  "entrypoint": "/",
  "accent": "#2e6b5d",
  "screenshots": [],
  "visibility": "private",
  "allowFork": false,
  "publisher": {
    "accountId": "__GOALMATIC_ACCOUNT_ID__",
