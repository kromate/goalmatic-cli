  "capabilities": [
    {
      "id": "tables",
      "kind": "tables",
      "displayName": "Store private tasks",
      "description": "Creates and manages private todo records for the signed-in Goalmatic account.",
      "operations": [
        "tables.records-list",
        "tables.record-create",
        "tables.record-update",
        "tables.record-delete"
