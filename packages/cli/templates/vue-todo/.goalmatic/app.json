          { "id": "completed", "name": "Completed", "type": "boolean", "required": true }
        ]
      }
    ],
    "agents": [],
    "workflows": [],
    "tools": [],
    "nodes": []
  },
  "updatePolicy": { "automaticWithoutNewCapabilities": true },
  "uninstallPolicy": { "retainDataDays": 30, "exposeTablesAfterUninstall": true }
